# Database
# username:password@host:port/database
DATABASE_URL="mysql://root:password@localhost:3306/iave_clinic"

# JWT - change these to your own random strings (e.g. run: openssl rand -hex 32)
JWT_ACCESS_SECRET="your-access-token-secret-change-this"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Backend
BACKEND_URL="http://localhost:3000"

# AI (OpenAI-compatible) - Leave empty to use rule-based fallback
AI_API_KEY=""
AI_MODEL="gpt-3.5-turbo"

# SMS - Leave SMS_API_KEY empty and SMS_PROVIDER="mock" to avoid real texts
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER="Souvari Skin Lab"
TEXTBEE_DEVICE_ID=""

# Email (SMTP) - Optional. Leave empty to skip sending emails
MAIL_HOST=""
MAIL_PORT="587"
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM_NAME="Souvari Skin Lab"

# App
NODE_ENV="development"
PORT=3000