# Database
DATABASE_URL="mysql://root:password@localhost:3306/iave_clinic"

# JWT
JWT_ACCESS_SECRET="your-access-token-secret-change-this"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-this"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Backend
BACKEND_URL="http://localhost:3000"

# AI (OpenAI) - Leave empty to use rule-based fallback
AI_API_KEY=""
AI_MODEL="gpt-3.5-turbo"

# SMS - Leave empty to use mock provider
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER="IAVE Beauty"

# App
NODE_ENV="development"
PORT=3000
