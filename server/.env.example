# Server environment variables (copy to .env and fill in values).
# DATABASE_URL, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are required.

NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://user:password@localhost:3306/souvari_clinic

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Chatbot (OpenAI-compatible). The OpenAI API key must live ONLY here and on
# the server - never in the client. When AI_API_KEY is empty, the server uses a
# built-in rule-based engine that still answers service/pricing/booking questions.
# ---------------------------------------------------------------------------
AI_API_KEY=
# Model used for chat completions. A modern, cheap default is gpt-4o-mini.
AI_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible providers (Azure, OpenRouter, self-hosted).
AI_BASE_URL=

# SMS / notifications (optional; mock provider used by default)
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=Souvari Skin Lab
TEXTBEE_DEVICE_ID=

# Email (optional; used only if MAIL_USER/MAIL_PASS are configured)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Souvari Skin Lab