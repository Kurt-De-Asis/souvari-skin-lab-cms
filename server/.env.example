# Server environment variables (copy to .env and fill in values).
# DATABASE_URL, JWT_ACCESS_SECRET and JWT_REFRESH_SECRET are required.

NODE_ENV=development
PORT=3000

DATABASE_URL=mysql://user:password@localhost:3306/souvari_clinic

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Chatbot (OpenAI-compatible). The OpenAI API key must live ONLY here and on
# the server - never in the client. When AI_API_KEY is empty, the server uses a
# built-in rule-based engine that still answers service/pricing/booking questions.
# ---------------------------------------------------------------------------
AI_API_KEY=
# Model used for chat completions. A modern, cheap default is gpt-4o-mini.
AI_MODEL=gpt-4o-mini
# Optional base URL for OpenAI-compatible providers (Azure, OpenRouter, self-hosted).
AI_BASE_URL=

# SMS / notifications (optional; mock provider used by default)
# Option 1 - Semaphore (Philippine gateway):
#   SMS_PROVIDER=semaphore
#   SMS_API_KEY=<key from semaphore.co>
#   SMS_SENDER=<approved Sender Name, max 11 alphanumeric chars, e.g. SOUVARI>
# Option 2 - TextBee (device gateway):
#   SMS_PROVIDER=textbee
#   SMS_API_KEY=<textbee api key>
#   TEXTBEE_DEVICE_ID=<textbee device id>
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=SOUVARI
TEXTBEE_DEVICE_ID=

# Appointment reminders: daily 24h-before SMS/in-app batch at the set local hour
REMINDERS_ENABLED=true
REMINDER_RUN_HOUR=8

# Email (optional; used only if MAIL_USER/MAIL_PASS are configured)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Souvari Skin Lab