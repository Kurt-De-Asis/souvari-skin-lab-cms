# Production environment
# Railway (deploy/paas-github/README.md): set these as web-service Variables
# Clinic Windows PC (deploy/cloudflare-clinic/README.md): copy to server\.env
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

NODE_ENV=production
PORT=3000

# Railway: paste the internal connection string from your MySQL service
# Clinic PC: local MySQL on this machine
DATABASE_URL=mysql://root:YOUR_DB_PASSWORD@localhost:3306/iave_clinic

# Generate two DIFFERENT random secrets
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Same origin: your live domain (Railway URL or custom domain)
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com

# AI chatbot (leave empty to use the built-in rule-based engine)
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# SMS (optional). set SMS_PROVIDER=mock to disable real texts
# Semaphore: SMS_PROVIDER=semaphore + SMS_API_KEY=<semaphore key> + SMS_SENDER=<approved sender>
# TextBee:   SMS_PROVIDER=textbee + SMS_API_KEY=<textbee key> + TEXTBEE_DEVICE_ID=<device id>
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER=SOUVARI
TEXTBEE_DEVICE_ID=

# Appointment reminders: daily batch at the set LOCAL hour (Asia/Manila)
REMINDERS_ENABLED=true
REMINDER_RUN_HOUR=8
TZ=Asia/Manila

# Email (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Souvari Skin Lab