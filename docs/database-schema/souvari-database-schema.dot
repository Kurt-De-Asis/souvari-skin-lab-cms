      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">name</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sku</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">unit_price</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">current_stock</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">is_retail</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR>
    </TABLE>>];

  // ── INVENTORY MOVEMENTS ──────────────────────────────────────
  inventory_movements [label=<
    <TABLE BORDER="1" COLOR="#b23b3b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f4">
      <TR><TD COLSPAN="2" BGCOLOR="#e9e9e9" ALIGN="CENTER"><FONT POINT-SIZE="11"><B>inventory_movements</B></FONT></TD></TR>
      <TR><TD COLSPAN="2" CELLPADDING="0" HEIGHT="1" BGCOLOR="#b23b3b"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#9e2b2b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">product_id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">performed_by</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">type</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">quantity</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">running_stock_after</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR>
    </TABLE>>];

  // ── NOTIFICATIONS ────────────────────────────────────────────
  notifications [label=<
    <TABLE BORDER="1" COLOR="#b23b3b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f4">
      <TR><TD COLSPAN="2" BGCOLOR="#e9e9e9" ALIGN="CENTER"><FONT POINT-SIZE="11"><B>notifications</B></FONT></TD></TR>
      <TR><TD COLSPAN="2" CELLPADDING="0" HEIGHT="1" BGCOLOR="#b23b3b"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#9e2b2b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">type</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">message</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">read_at</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR>
    </TABLE>>];

  // ── SMS LOGS ─────────────────────────────────────────────────
  sms_logs [label=<
    <TABLE BORDER="1" COLOR="#b23b3b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f4">
      <TR><TD COLSPAN="2" BGCOLOR="#e9e9e9" ALIGN="CENTER"><FONT POINT-SIZE="11"><B>sms_logs</B></FONT></TD></TR>
      <TR><TD COLSPAN="2" CELLPADDING="0" HEIGHT="1" BGCOLOR="#b23b3b"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#9e2b2b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">recipient_phone</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">message</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sent_at</FONT></TD></TR>
    </TABLE>>];

  // ── CHAT SESSIONS ────────────────────────────────────────────
  chat_sessions [label=<
    <TABLE BORDER="1" COLOR="#b23b3b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f4">
      <TR><TD COLSPAN="2" BGCOLOR="#e9e9e9" ALIGN="CENTER"><FONT POINT-SIZE="11"><B>chat_sessions</B></FONT></TD></TR>
      <TR><TD COLSPAN="2" CELLPADDING="0" HEIGHT="1" BGCOLOR="#b23b3b"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#9e2b2b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">user_id</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">session_token</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">started_at</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ended_at</FONT></TD></TR>
    </TABLE>>];

  // ── CHAT MESSAGES ────────────────────────────────────────────
  chat_messages [label=<
    <TABLE BORDER="1" COLOR="#b23b3b" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#f4f4f4">
      <TR><TD COLSPAN="2" BGCOLOR="#e9e9e9" ALIGN="CENTER"><FONT POINT-SIZE="11"><B>chat_messages</B></FONT></TD></TR>
      <TR><TD COLSPAN="2" CELLPADDING="0" HEIGHT="1" BGCOLOR="#b23b3b"></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#9e2b2b"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">id</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#2b5c9e"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">session_id</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sender_type</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">content</FONT></TD></TR>
      <TR><TD></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10">created_at</FONT></TD></TR>
    </TABLE>>];

  // ── RELATIONSHIPS (tail = "1" side, head = child side) ───────
  // One-to-one
  users -> customers            [taillabel="1", headlabel="1", labeldistance=2.2, labelangle=35];
  users -> staff                [taillabel="1", headlabel="1", labeldistance=2.2, labelangle=35];
  users -> admins               [taillabel="1", headlabel="1", labeldistance=2.2, labelangle=35];
  appointments -> treatment_records [taillabel="1", headlabel="1", labeldistance=2.2, labelangle=35];
  // One-to-many
  users -> notifications        [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  users -> sms_logs             [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  users -> chat_sessions        [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  users -> inventory_movements  [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  admins -> system_settings     [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  staff -> staff_schedules      [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  customers -> appointments     [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
  staff -> appointments         [taillabel="1", headlabel="&#8734;", labeldistance=2.2, labelangle=35];
